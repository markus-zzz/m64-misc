/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * ModRetro M64 board devicetree.
 * SoC: STM32H7A3ZIT6 (LQFP144).
 *
 */

/dts-v1/;

/* Base SoC devicetree for the STM32H7A3xI (2 MB flash) family. */
#include <st/h7/stm32h7a3Xi.dtsi>
/* Pin control definitions for the ZI (LQFP144) package.
 * Non-Q (without-SMPS) variant: this is the STM32H7A3ZIT6 pinout that exposes
 * PF0-PF15 and PG0-PG15 (the SMPS supply pins are reassigned as GPIO.)
 */
#include <st/h7/stm32h7a3z(g-i)tx-pinctrl.dtsi>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "ModRetro M64";
	compatible = "modretro,m64";

	chosen {
		/*
		 * Primary console (printk, logs, boot banner, faults) on the
		 * USB CDC-ACM port. USART2 remains available as a wired backup
		 * but is no longer the chosen console.
		 */
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		/* Place code tagged __itcm_section in zero-wait-state ITCM
		 * (used for the cycle-tight WS2812 bit-bang). */
		zephyr,itcm = &itcm;
	};

	/*
	 * Board-specific general-purpose GPIOs (Option B: custom node,
	 * driven directly via GPIO_DT_SPEC_GET(DT_NODELABEL(...), gpios)).
	 */
	m64_gpios {
		compatible = "gpio-keys";
		// Power domain enables
		vsys_led_on: vsys_led_on {
			gpios = <&gpiog 15 GPIO_ACTIVE_HIGH>;
			label = "VSYS LED Enable";
		};
		fpga_pwr_en: fpga_pwr_en {
			gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
			label = "FPGA Power Enable (PC5)";
		};

		// LEDs
		ctrl_led_data_0: ctrl_led_data_0 {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			label = "LED Ctrl 0";
		};
		ctrl_led_data_1: ctrl_led_data_1 {
			gpios = <&gpiob 3 GPIO_ACTIVE_HIGH>;
			label = "LED Ctrl 1";
		};
		ctrl_led_data_2: ctrl_led_data_2 {
			gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
			label = "LED Ctrl 2";
		};
		ctrl_led_data_3: ctrl_led_data_3 {
			gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
			label = "LED Ctrl 3";
		};

		// FPGA interface
		fpga_ss_boot_ctrl: fpga_ss_boot_ctrl {
			gpios = <&gpiog 13 GPIO_ACTIVE_HIGH>;
			label = "FPGA mode strap ctrl (PG13, high=M1/M2 driven to 1V8 => M[2:0]=111)";
		};
		fpga_init_b: fpga_init_b {
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			label = "FPGA INIT_B (PC13)";
		};
		fpga_program_b: fpga_program_b {
			gpios = <&gpioe 6 GPIO_ACTIVE_LOW>;
			label = "FPGA PROGRAM_B (PE6, active-low)";
		};
		fpga_done: fpga_done {
			gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
			label = "FPGA DONE (PE5)";
		};

		/*
		 * Slave-Serial configuration clock/data, bit-banged as plain
		 * GPIOs (temporary bring-up). CCLK=PF4, DIN=PF0. Bitstream is
		 * shifted MSB-first, one bit per CCLK rising edge.
		 */
		fpga_cclk: fpga_cclk {
			gpios = <&gpiof 4 GPIO_ACTIVE_HIGH>;
			label = "FPGA CCLK (PF4)";
		};
		fpga_din: fpga_din {
			gpios = <&gpiof 1 GPIO_ACTIVE_HIGH>;
			label = "FPGA DIN (PF1)";
		};

		/*
		 * Config flash chip-select (PG12 = OCTOSPI2 NCS). The bitstream
		 * flash shares the CCLK/DIN bus with the FPGA's Slave-Serial
		 * input, so it must be DESELECTED (CS# high) during FPGA config
		 * to keep it off the shared IO0/DIN line. Active-low.
		 */
		flash_cs: flash_cs {
			gpios = <&gpiog 12 GPIO_ACTIVE_LOW>;
			label = "Config flash CS# (PG12, active-low)";
		};
	};
};

/*
 * Clock tree.
 *
 * HSE: 24 MHz passive crystal across PH0-OSC_IN / PH1-OSC_OUT (no bypass).
 * PLL1: 24 MHz / M=12 = 2 MHz ref; xN=280 -> VCO 560 MHz; /P=2 -> 280 MHz SYSCLK.
 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&clk_hsi48 {
	/* 48 MHz RC, useful for USB/RNG. */
	status = "okay";
};

&pll {
	div-m = <12>;
	mul-n = <280>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

/*
 * PLL2 provides the 48 MHz SDMMC1 kernel clock (via PLL2R).
 *
 * HSE 24 MHz / M=4 = 6 MHz ref; xN=80 -> VCO 480 MHz; /R=10 -> 48 MHz.
 * (P and Q are unused here but must be valid dividers.)
 */
&pll2 {
	div-m = <4>;
	mul-n = <80>;
	div-p = <2>;
	div-q = <2>;
	div-r = <10>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(280)>;
	d1cpre = <1>;
	hpre = <1>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

/*
 * Shell / boot-log / console UART.
 *
 * USART2: TX = PA2, RX = PD6 (per M64 schematic).
 */
&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/*
 * USB OTG HS running on the internal full-speed PHY (PA11/PA12).
 *
 * This is the same connector used for ROM-bootloader DFU. Full-speed
 * (12 Mbit/s) is ample for a CDC-ACM console. Inherits the SoC-default
 * clocks (AHB1 USB1OTGHSEN + HSI48) and the internal usb-nop-xceiv PHY.
 *
 * NOTE: The external USB3300 ULPI HS PHY is on a separate port and is not
 * used here; switch back to it if Hi-Speed throughput is needed later.
 */
zephyr_udc0: &usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_dm_pa11 &usb_otg_hs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/*
 * SD card on SDMMC1 (4-bit bus).
 *
 *   CK  = PC12   CMD = PD2
 *   D0  = PC8    D1  = PC9    D2  = PC10   D3  = PC11
 *   DET = PE15 (card-detect, active-low: pulled low when a card is present)
 *
 * The SDMMC kernel clock is provided by the SoC default; adjust the RCC
 * domain-clock source here if the card fails to initialise.
 */
&sdmmc1 {
	pinctrl-0 = <&sdmmc1_ck_pc12 &sdmmc1_cmd_pd2
		     &sdmmc1_d0_pc8 &sdmmc1_d1_pc9
		     &sdmmc1_d2_pc10 &sdmmc1_d3_pc11>;
	pinctrl-names = "default";
	/* AHB3 bus-clock gate + 48 MHz kernel clock from PLL2R (SDMMC_SEL=1). */
	clocks = <&rcc STM32_CLOCK_BUS_AHB3 0x00010000>,
		 <&rcc STM32_SRC_PLL2_R SDMMC_SEL(1)>;
	cd-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>;
	bus-width = <4>;
	/* Card clock = SDMMCCLK / (2 * clk-div) = 48 MHz / 8 = 6 MHz.
	 * The card is unreliable at full speed on this layout; 6 MHz is
	 * stable. Lower clk-div (toward 0) to go faster if margins allow. */
	clk-div = <4>;
	disk-name = "SD";
	status = "okay";
};
